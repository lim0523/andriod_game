<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="22dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- 蛇形Logo -->
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_snake_logo"
            android:contentDescription="logo"
            android:layout_marginBottom="8dp" />

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEON SNAKE"
            android:textColor="@color/neon_green"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:shadowColor="@color/neon_green"
            android:shadowRadius="16"
            android:shadowDx="0"
            android:shadowDy="0" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="霓虹街机 · 手势操控"
            android:textColor="@color/neon_blue"
            android:textSize="13sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="2dp"
            android:shadowColor="@color/neon_blue"
            android:shadowRadius="8"
            android:shadowDx="0"
            android:shadowDy="0" />

        <!-- 装饰分割线 -->
        <View
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_divider_neon" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_home_panel">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="CLASSIC"
                android:textColor="@color/neon_green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="TIME"
                android:textColor="@color/gold"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="GESTURE"
                android:textColor="@color/neon_blue"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 开始游戏 - 渐变主按钮 -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/start_game"
            android:textColor="@color/bg_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:backgroundTint="@null"
            android:background="@drawable/bg_btn_gradient"
            app:cornerRadius="27dp"
            android:stateListAnimator="@null" />

        <!-- 皮肤主题 -->
        <Button
            android:id="@+id/btn_skin"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="@string/skin_theme"
            android:textColor="@color/neon_green"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            app:backgroundTint="@null"
            android:background="@drawable/bg_btn_outline"
            app:cornerRadius="23dp"
            android:stateListAnimator="@null"
            android:layout_marginTop="10dp" />

        <!-- 排行榜 -->
        <Button
            android:id="@+id/btn_leaderboard"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="@string/leaderboard"
            android:textColor="@color/neon_blue"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            app:backgroundTint="@null"
            android:background="@drawable/bg_btn_outline_blue"
            app:cornerRadius="23dp"
            android:stateListAnimator="@null"
            android:layout_marginTop="10dp" />

        <!-- 成就 -->
        <Button
            android:id="@+id/btn_achievements"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="@string/achievements"
            android:textColor="@color/gold"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            app:backgroundTint="@null"
            android:background="@drawable/bg_btn_outline_gold"
            app:cornerRadius="23dp"
            android:stateListAnimator="@null"
            android:layout_marginTop="10dp" />

        <!-- 设置 -->
        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="@string/settings"
            android:textColor="@color/purple"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            app:backgroundTint="@null"
            android:background="@drawable/bg_btn_outline_purple"
            app:cornerRadius="23dp"
            android:stateListAnimator="@null"
            android:layout_marginTop="10dp" />

        <!-- 最高分徽章 -->
        <TextView
            android:id="@+id/tv_best_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/neon_green"
            android:textSize="13sp"
            android:letterSpacing="0.04"
            android:paddingHorizontal="20dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_score_badge"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
